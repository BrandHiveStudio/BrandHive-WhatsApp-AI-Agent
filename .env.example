# Meta WhatsApp Business API
WHATSAPP_ACCESS_TOKEN=            # Permanent access token from Meta Business > System Users > Generate Token
WHATSAPP_PHONE_NUMBER_ID=        # Phone Number ID from Meta App > WhatsApp > API Setup
WHATSAPP_VERIFY_TOKEN=           # Any string you choose (e.g. "myverifytoken123") - used to verify webhook
WHATSAPP_APP_SECRET=             # Meta App > Settings > Basic > App Secret - used to verify X-Hub-Signature-256 on incoming webhooks

# AI Model (OpenRouter or OpenAI-compatible)
OPENROUTER_API_KEY=              # API key from openrouter.ai (or use OPENAI_API_KEY if using OpenAI directly)
AI_MODEL=minimax/minimax-m2.5:free  # Model to use via OpenRouter

# Supabase -- BrandHive WhatsApp AI Agent project (ref: koyedzjnwxbjzotnhvtg)
# The URL is not secret (it's a public client-side value); the two keys below are.
NEXT_PUBLIC_SUPABASE_URL=https://koyedzjnwxbjzotnhvtg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # Supabase anon/public key (for frontend) - Project Settings > API
SUPABASE_SERVICE_ROLE_KEY=       # Supabase service role key (for backend/webhook) - Project Settings > API

# Meta Facebook Login for Business / Coexistence Onboarding (Public client-side identifiers)
NEXT_PUBLIC_META_APP_ID=1395774185211806
NEXT_PUBLIC_META_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID= # Numeric Configuration ID from Meta Developer Dashboard > Facebook Login for Business > Configurations

# App Config
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
